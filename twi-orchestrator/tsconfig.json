{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ESNext.Disposable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    /*
     * skipLibCheck is scoped to THIRD-PARTY declarations and is not hiding anything of
     * ours: with it off, this package's own files report ZERO errors, and the 11 that
     * remain are all inside node_modules -- 7 in @cloudflare/vitest-plugin's own
     * cloudflare-test.d.ts (it references FetcherScheduledOptions, FetcherQueueResult and
     * ServiceBindingQueueMessage, which the generated runtime types do not declare) and 4
     * in tinybench, a vitest dependency this package never imports. Neither is fixable
     * from here, and neither can mask a defect in src/ or test/, which are still fully
     * checked. Re-run without it after a plugin upgrade to see whether it can be dropped.
     */
    "skipLibCheck": true,
    /*
     * ONE Workers type source, not three. runtime-types.d.ts is generated by
     * `wrangler types --include-env=false runtime-types.d.ts` for THIS package's exact
     * compatibility_date, and replaces @cloudflare/workers-types entirely (wrangler's own
     * instruction on generation). Loading the package alongside it was 1,633 duplicate-
     * global errors: 2023-07-01 and experimental each declare the full global surface,
     * and they conflict with each other before anything else. Re-run wrangler types
     * after any wrangler.toml change.
     */
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "worker-configuration.d.ts", "runtime-types.d.ts"]
}
